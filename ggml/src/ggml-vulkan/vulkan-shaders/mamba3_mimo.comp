#version 450

#extension GL_EXT_control_flow_attributes : require

// Fused Olala Mamba3-MIMO mixer core (see ggml_mamba3_mimo in ggml.h).
// semantic reference: ggml_compute_forward_mamba3_mimo (ggml/src/ggml-cpu/ops.cpp),
// structure follows the CUDA kernel (ggml/src/ggml-cuda/mamba3-mimo.cu).
//
// One workgroup per (head, seq), serial over the tokens of the sequence. Every
// token step builds its operands from the raw projections in shared memory
// (B/C rms-norm + weight + bias + rotary, x/z MIMO scaling, softplus/exp/sigmoid
// discretization), then updates the state and applies the D skip, the SiLU(z)
// gate and the MIMO output combine.
//
// Each state row p is owned by NSL invocations that stride over d (adjacent
// invocations touch adjacent state elements). In the direct form the state
// update and the q.S contraction share registers: as on the CPU, the R output
// contractions are folded into one, with w[r] = mimo_o[r,p]*silu(z[r,p]),
//   y[p] = sum_d S[p,d]*(sum_r w[r]*q[r,d]) + D*sum_r w[r]*v[r,p]
// and the NSL partial sums of a row meet in shared memory. No subgroup
// operations are used, so the shader does not depend on the subgroup size.
//
// The CPU has two evaluation orders. For fewer than PREFILL_T tokens per
// sequence it applies S = alpha*S + beta*kv_prev + gamma*kv directly. From
// PREFILL_T on it carries U = S + delta*kv with delta = (1 - trap)*dt of the
// next token, so that one update per token is enough:
//   U = alpha*U + (gamma + delta)*kv
//   y = sum_r w_r (q_r.U + D v_r - delta sum_r2 v_r2 (k_r2.q_r))
// The two agree up to rounding, but not when gamma is lost against delta, so
// the shader follows the CPU's choice.
//
// REG = 1 keeps the invocation's share of the state in registers for the whole
// sequence (one load and one store of the state per ubatch instead of one per
// token); REG = 0 reads and writes the state buffers every token, which is the
// same amount of traffic when T == 1.

#define NTH   256
#define MAX_R 8
#define PREFILL_T 4 // M3_PREFILL_T of the CPU reference

layout(constant_id = 0) const uint R    = 4;   // MIMO rank, <= MAX_R
layout(constant_id = 1) const uint D_QK = 128; // multiple of 4, <= 4*NTH
layout(constant_id = 2) const uint D_V  = 64;  // D_V*NSL <= NTH
layout(constant_id = 3) const uint NSL  = 4;   // invocations per state row
layout(constant_id = 4) const uint REG  = 0;   // 1: state stays in registers across tokens

layout(local_size_x = NTH, local_size_y = 1, local_size_z = 1) in;

const uint N_ANG  = D_QK / 4;
const uint SD     = D_QK * D_V;
const uint SREG   = (D_QK + NSL - 1) / NSL; // state elements per invocation
// invocations per k.q product. When D_V is a multiple of 4 the CPU's own order depends on its
// vector width; otherwise it is increasing d on every build, and the shader keeps that order.
const uint GSPLIT = D_V % 4 == 0 ? NTH / (R * R) : 1;

layout(binding = 0) readonly buffer Pdyn  { float pdyn[];   };
layout(binding = 1) readonly buffer Pstat { float pstat[];  };
layout(binding = 2) readonly buffer Bias  { float bias[];   };
layout(binding = 3) readonly buffer Mxz   { float mxz[];    };
layout(binding = 4) readonly buffer MimoO { float mimo_o[]; };
layout(binding = 5) readonly buffer Norms { float norms[];  };
layout(binding = 6) readonly buffer Misc  { float misc[];   };
layout(binding = 7) readonly buffer State { float s_in[];   };
// coherent: in the prefill form an invocation reads state that others of its workgroup wrote
layout(binding = 8) coherent buffer Dst   { float dst[];    };

layout(push_constant) uniform PushConstants {
    // misalignment of each binding, in floats
    uint o_pdyn; uint o_pstat; uint o_bias; uint o_mxz; uint o_mimo; uint o_norms; uint o_misc; uint o_state; uint o_dst;
    uint pdyn_s;   // token strides, in floats
    uint pstat_s;
    uint s_in_s;   // sequence stride of the input state, in floats
    uint H;
    uint T;        // tokens per sequence
    uint n_embd_s;
    uint y_size;   // D_V*H*n_tok: offset of the new state inside dst
    float eps;
    float a_floor;
};

shared float kb[2 * R * D_QK]; // k of the previous and of the current token
shared float qb[R * D_QK];
shared float vb[2 * R * D_V];
shared float zb[R * D_V];
shared float cs[N_ANG];
shared float sn[N_ANG];
shared float rms[2 * R];
// The CPU sums the squares of a B/C group in double, in index order, and so
// does the shader: the op needs shaderFloat64.
shared float opart[R * NTH]; // direct form: the row's NSL partials. Prefill form: q_r.U of row p at [r*NTH + p*NSL]
shared float gpart[NTH];     // prefill form: partials of G[r2][r] = k_r2 . q_r
shared float gram[R * R];

float softplus(float x) {
    return max(x, 0.0) + log(exp(-abs(x)) + 1.0);
}

float wrap_angle(float a) {
    return a - 6.283185307179586 * roundEven(a * 0.15915494309189535);
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint h   = gl_WorkGroupID.y;
    const uint seq = gl_WorkGroupID.z;

    const uint off_K = H * SD;
    const uint off_V = off_K + H * R * D_QK;
    const uint off_A = off_V + H * R * D_V;

    const uint si   = o_state + seq * s_in_s;        // input state of this sequence
    const uint so   = o_dst + y_size + seq * n_embd_s; // output state of this sequence
    const uint tok0 = seq * T;

    const uint b_h  = o_bias + h * 2 * R * D_QK;
    const uint mx_h = o_mxz  + h * 2 * R * D_V;
    const uint mo_h = o_mimo + h * R * D_V;

    // previous token's k/v come from the cache
    uint prv = 1;
    for (uint j = tid; j < R * D_QK; j += NTH) {
        kb[prv * R * D_QK + j] = s_in[si + off_K + h * R * D_QK + j];
    }
    for (uint j = tid; j < R * D_V; j += NTH) {
        vb[prv * R * D_V + j] = s_in[si + off_V + h * R * D_V + j];
    }
    float ang = 0.0; // invocation tid < N_ANG owns rotary phase tid
    if (tid < N_ANG) {
        ang = s_in[si + off_A + h * N_ANG + tid];
    }
    barrier();

    const float dt_bias = misc[o_misc + h];
    const float D_h     = misc[o_misc + H + h];

    const uint p  = tid / NSL; // state row
    const uint sl = tid % NSL; // slice of the row
    const uint sp = h * SD + p * D_QK;

    float sreg[SREG];
    if (REG != 0 && p < D_V) {
        for (uint i = 0, d = sl; d < D_QK; ++i, d += NSL) {
            sreg[i] = s_in[si + sp + d];
        }
    }

    const bool look = T >= PREFILL_T;
    float dt_n = 0.0, alpha_n = 0.0, trap_n = 0.0;
    {
        const uint ps = o_pstat + tok0 * pstat_s + h * (2 * D_V + 3);
        dt_n    = softplus(pstat[ps + 2 * D_V] + dt_bias);
        alpha_n = exp(min(-softplus(pstat[ps + 2 * D_V + 1]), -a_floor) * dt_n);
        trap_n  = 1.0 / (1.0 + exp(-pstat[ps + 2 * D_V + 2]));
    }
    const float delta0 = (1.0 - trap_n) * dt_n;

    for (uint t = 0; t < T; ++t) {
        const uint tok = tok0 + t;
        const uint cur = prv ^ 1;
        const uint pd  = o_pdyn  + tok * pdyn_s;
        const uint ps  = o_pstat + tok * pstat_s + h * (2 * D_V + 3);

        const float dt    = dt_n;
        const float alpha = alpha_n;
        const float trap  = trap_n;
        const float beta  = (1.0 - trap) * dt * alpha;
        const float gamma = trap * dt;
        float delta = 0.0; // (1 - trap)*dt of the next token
        if (t + 1 < T) {
            const uint pn = ps + pstat_s;
            dt_n    = softplus(pstat[pn + 2 * D_V] + dt_bias);
            alpha_n = exp(min(-softplus(pstat[pn + 2 * D_V + 1]), -a_floor) * dt_n);
            trap_n  = 1.0 / (1.0 + exp(-pstat[pn + 2 * D_V + 2]));
            delta   = (1.0 - trap_n) * dt_n;
        }
        const float c_look = gamma + delta;

        if (tid < N_ANG) {
            ang = wrap_angle(ang + tanh(pdyn[pd + 2 * R * D_QK + tid]) * 3.14159265358979 * dt);
            cs[tid] = cos(ang);
            sn[tid] = sin(ang);
        }

        // rms scales of the 2R groups of B/C
        if (tid < 2 * R) {
            precise double s = 0.0;
            for (uint d = 0; d < D_QK; ++d) {
                const double x = double(pdyn[pd + tid * D_QK + d]);
                s += x * x;
            }
            const float ms = float(s / double(D_QK));
            rms[tid] = isinf(ms) ? 0.0 : inversesqrt(ms + eps);
        }
        barrier();

        // operands: k (B groups) and q (C groups) with weight, bias and rotary; v and z
        const uint half_d = D_QK / 2, quarter = D_QK / 4;
        for (uint j = tid; j < 2 * R * D_QK; j += NTH) {
            const uint  gg  = j / D_QK;
            const uint  d   = j % D_QK;
            const uint  src = pd + gg * D_QK;
            const uint  w   = o_norms + (gg < R ? 0 : D_QK);
            const uint  b   = b_h + gg * D_QK;
            const float sc  = rms[gg];
            float o;
            if (d < quarter) {
                const float v0 = pdyn[src + d] * sc * norms[w + d] + bias[b + d];
                const float v2 = pdyn[src + d + half_d] * sc * norms[w + d + half_d] + bias[b + d + half_d];
                o = v0 * cs[d] - v2 * sn[d];
            } else if (d >= half_d && d < half_d + quarter) {
                const uint  i  = d - half_d;
                const float v0 = pdyn[src + i] * sc * norms[w + i] + bias[b + i];
                const float v2 = pdyn[src + d] * sc * norms[w + d] + bias[b + d];
                o = v0 * sn[i] + v2 * cs[i];
            } else {
                o = pdyn[src + d] * sc * norms[w + d] + bias[b + d];
            }
            if (gg < R) {
                kb[cur * R * D_QK + j] = o;
            } else {
                qb[j - R * D_QK] = o;
            }
        }
        for (uint j = tid; j < R * D_V; j += NTH) {
            const uint pp = j % D_V;
            vb[cur * R * D_V + j] = pstat[ps + D_V + pp] * mxz[mx_h + j];
            zb[j]                 = pstat[ps + pp] * mxz[mx_h + R * D_V + j];
        }
        barrier();

        // state update and the partial output contractions of row p
        float vc[MAX_R], w[MAX_R];
        if (p < D_V) {
            float vp[MAX_R];
            for (uint r = 0; r < R; ++r) {
                vc[r] = vb[cur * R * D_V + r * D_V + p];
                vp[r] = vb[prv * R * D_V + r * D_V + p];
                const float zv = zb[r * D_V + p];
                w[r]  = mimo_o[mo_h + r * D_V + p] * (zv / (1.0 + exp(-zv)));
            }
            const uint kc = cur * R * D_QK;
            const uint kp = prv * R * D_QK;
            const bool need_prev = !look || t == 0;
            // direct form: one contraction with sum_r w_r q_r, summed here. Prefill form:
            // one per rank, summed below in the CPU's order
            float acc = 0.0;
            for (uint i = 0, d = sl; d < D_QK; ++i, d += NSL) {
                float c_acc = 0.0, p_acc = 0.0;
                for (uint r = 0; r < R; ++r) {
                    c_acc += vc[r] * kb[kc + r * D_QK + d];
                }
                if (need_prev) {
                    for (uint r = 0; r < R; ++r) {
                        p_acc += vp[r] * kb[kp + r * D_QK + d];
                    }
                }
                float s;
                if (REG != 0) {
                    s = sreg[i];
                } else if (t == 0) {
                    s = s_in[si + sp + d];
                } else {
                    s = dst[so + sp + d];
                }
                if (look) {
                    if (t == 0) {
                        s += delta0 * p_acc; // U_0 = S_0 + delta_0 kv_0
                    }
                    s = alpha * s + c_look * c_acc;
                } else {
                    float qw = 0.0;
                    for (uint r = 0; r < R; ++r) {
                        qw += w[r] * qb[r * D_QK + d];
                    }
                    s = alpha * s + beta * p_acc + gamma * c_acc;
                    acc += s * qw;
                }
                if (REG != 0) {
                    sreg[i] = s;
                }
                if (REG == 0 || look) {
                    dst[so + sp + d] = s; // the prefill form reads the whole row back below
                }
            }
            opart[tid] = acc;
        }
        // prefill correction: the R*R products k_r2 . q_r of this token
        const bool gram_on = look && delta != 0.0;
        if (gram_on && tid < GSPLIT * R * R) {
            const uint pr = tid % (R * R);
            const uint r2 = pr / R, r1 = pr % R;
            float gsum = 0.0;
            for (uint d = tid / (R * R); d < D_QK; d += GSPLIT) {
                gsum += kb[cur * R * D_QK + r2 * D_QK + d] * qb[r1 * D_QK + d];
            }
            gpart[tid] = gsum;
        }
        memoryBarrierBuffer();
        barrier();
        if (gram_on && tid < R * R) {
            float gsum = gpart[tid];
            for (uint i = 1; i < GSPLIT; ++i) {
                gsum += gpart[i * R * R + tid];
            }
            gram[tid] = gsum;
        }
        // prefill form: o_r = q_r.U of the row. The CPU adds it in increasing d on every
        // build, and the epilogue's subtraction can expose a different order, so the
        // row's invocations take one rank each and walk the whole row.
        if (look && p < D_V) {
            for (uint r = sl; r < R; r += NSL) {
                precise float o = 0.0;
                for (uint d = 0; d < D_QK; ++d) {
                    o += qb[r * D_QK + d] * dst[so + sp + d];
                }
                opart[r * NTH + tid - sl] = o;
            }
        }
        barrier();

        // the row's partials and the D skip, combined as on the CPU. Nothing read
        // here is written before the second barrier of the next token.
        if (sl == 0 && p < D_V) {
            float yp = 0.0;
            if (look) {
                // y = sum_r w_r (o_r + D v_r - delta corr_r)
                for (uint r = 0; r < R; ++r) {
                    float e = opart[r * NTH + tid] + D_h * vc[r];
                    if (delta != 0.0) {
                        float c = 0.0;
                        for (uint r2 = 0; r2 < R; ++r2) {
                            c += vc[r2] * gram[r2 * R + r];
                        }
                        e -= delta * c;
                    }
                    yp += w[r] * e;
                }
            } else {
                // y = sum_r (D w_r) v_r, then the contraction
                for (uint r = 0; r < R; ++r) {
                    yp += (D_h * w[r]) * vc[r];
                }
                float o = 0.0;
                for (uint i = 0; i < NSL; ++i) {
                    o += opart[tid + i];
                }
                yp += o;
            }
            dst[o_dst + (tok * H + h) * D_V + p] = yp;
        }
        prv = cur;
    }

    // k/v of the last token feed the next ubatch's trapezoid term
    for (uint j = tid; j < R * D_QK; j += NTH) {
        dst[so + off_K + h * R * D_QK + j] = kb[prv * R * D_QK + j];
    }
    for (uint j = tid; j < R * D_V; j += NTH) {
        dst[so + off_V + h * R * D_V + j] = vb[prv * R * D_V + j];
    }
    if (tid < N_ANG) {
        dst[so + off_A + h * N_ANG + tid] = ang;
    }
    if (REG != 0 && p < D_V) {
        for (uint i = 0, d = sl; d < D_QK; ++i, d += NSL) {
            dst[so + sp + d] = sreg[i];
        }
    }
}
